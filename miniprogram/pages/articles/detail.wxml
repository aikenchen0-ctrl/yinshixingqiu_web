<navigation-bar
  title="{{article.navTitle}}"
  back="{{true}}"
  color="#22160d"
  background="#ffffff"
>
  <button
    wx:if="{{source === 'wechat' && articleId}}"
    slot="right"
    class="article-detail-nav-share"
    bindtap="onTapShare"
    aria-role="button"
    aria-label="转发文章"
  >
    <view class="article-detail-nav-share-icon">
      <view class="article-detail-nav-share-arrow"></view>
      <view class="article-detail-nav-share-box"></view>
    </view>
  </button>
</navigation-bar>

<scroll-view
  class="article-detail-page {{article.isWechatArticle ? 'article-detail-page-wechat' : 'article-detail-page-planet'}}"
  scroll-y="{{true}}"
  scroll-with-animation="{{true}}"
  scroll-into-view="{{scrollIntoViewId}}"
>
  <view wx:if="{{loading}}" class="article-detail-state-card">
    <text class="article-detail-state-title">正在加载文章</text>
    <text class="article-detail-state-subtitle">正在从真实后台读取文章内容。</text>
  </view>

  <view wx:elif="{{error}}" class="article-detail-state-card is-error" bindtap="onReload">
    <text class="article-detail-state-title">文章加载失败</text>
    <text class="article-detail-state-subtitle">{{error}}</text>
    <text class="article-detail-state-action">点击重试</text>
  </view>

  <block wx:else>
  <block wx:if="{{article.isWechatArticle}}">
    <view class="wechat-article-shell">
      <text class="wechat-article-title">{{article.title}}</text>

      <view class="wechat-article-meta">
        <text class="wechat-article-author">{{article.author}}</text>
        <text class="wechat-article-time">{{article.time}}</text>
        <text wx:if="{{article.authorTag}}" class="wechat-article-author-tag">{{article.authorTag}}</text>
      </view>

      <text wx:if="{{article.showStandaloneSummary}}" class="wechat-article-summary">{{article.summary}}</text>

      <image
        wx:if="{{article.showStandaloneCover}}"
        id="{{article.standaloneCoverAnchorId}}"
        class="wechat-article-cover"
        src="{{article.coverImage}}"
        mode="widthFix"
        bindload="onArticleVisualAssetLoad"
      ></image>

      <view wx:if="{{article.isRichContent}}" class="wechat-article-body">
        <block wx:for="{{article.bodyBlocks}}" wx:key="key">
          <view
            wx:if="{{item.type === 'rich'}}"
            id="{{item.anchorId}}"
            class="wechat-article-rich-block"
          >
            <rich-text
              class="wechat-article-rich-text"
              nodes="{{item.html}}"
            ></rich-text>
          </view>

          <button
            wx:elif="{{item.type === 'wechat-card'}}"
            id="{{item.anchorId}}"
            class="wechat-article-inline-card"
            data-index="{{index}}"
            bindtap="onTapWechatArticleCard"
          >
            <image
              wx:if="{{item.coverImage}}"
              class="wechat-article-inline-card-cover"
              src="{{item.coverImage}}"
              mode="aspectFill"
              bindload="onArticleVisualAssetLoad"
            ></image>
            <view class="wechat-article-inline-card-copy">
              <text class="wechat-article-inline-card-badge">文章卡片</text>
              <text class="wechat-article-inline-card-title">{{item.title}}</text>
              <text wx:if="{{item.summary}}" class="wechat-article-inline-card-summary">{{item.summary}}</text>
              <text class="wechat-article-inline-card-action">{{item.buttonText}}</text>
            </view>
          </button>
        </block>
      </view>

      <view wx:else class="wechat-article-content">
        <text
          class="wechat-article-paragraph"
          wx:for="{{article.visibleContent}}"
          wx:key="index"
        >{{item}}</text>
      </view>

      <view wx:if="{{article.showPaywallCard}}" class="wechat-article-paywall-card">
        <view class="wechat-article-paywall-mask"></view>
        <view class="wechat-article-paywall-copy">
          <text class="wechat-article-paywall-badge">付费阅读</text>
          <text class="wechat-article-paywall-title">{{article.paywallTitle}}</text>
          <text class="wechat-article-paywall-subtitle">{{article.paywallSubtitle}}</text>
          <text class="wechat-article-paywall-hint">{{article.hiddenHint}}</text>
        </view>
        <button class="wechat-article-paywall-button" bindtap="onOpenMoreContent">{{article.paywallButtonText}}</button>
      </view>

      <view class="wechat-article-footer">
        <view class="wechat-article-footer-line"></view>
        <text class="wechat-article-footer-meta">作者 {{article.author}} · {{article.readDuration}} · {{article.wordCount}}</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="planet-article-shell">
      <text class="planet-article-title">{{article.title}}</text>

      <view class="planet-article-meta">
        <text class="planet-article-author">作者 {{article.author}}</text>
      </view>

      <text wx:if="{{article.showStandaloneSummary}}" class="wechat-article-summary">{{article.summary}}</text>

      <image wx:if="{{article.showStandaloneCover}}" class="planet-article-cover" src="{{article.coverImage}}" mode="widthFix"></image>

      <rich-text
        wx:if="{{article.isRichContent}}"
        class="planet-article-rich-text"
        nodes="{{article.visibleRichContent}}"
      ></rich-text>

      <view wx:else class="planet-article-content">
        <text
          class="planet-article-paragraph"
          wx:for="{{article.visibleContent}}"
          wx:key="index"
        >{{item}}</text>
      </view>

      <view wx:if="{{article.showPaywallCard}}" class="planet-article-paywall-card">
        <view class="planet-article-paywall-copy">
          <text class="planet-article-paywall-badge">付费全文</text>
          <text class="planet-article-paywall-title">{{article.paywallTitle}}</text>
          <text class="planet-article-paywall-subtitle">{{article.paywallSubtitle}}</text>
          <text class="planet-article-paywall-hint">{{article.hiddenHint}}</text>
        </view>
        <button class="planet-article-paywall-button" bindtap="onOpenMoreContent">{{article.paywallButtonText}}</button>
      </view>
    </view>
  </block>
  </block>
</scroll-view>

<view
  wx:if="{{sharePickerVisible}}"
  class="article-share-picker-mask"
  bindtap="onCloseSharePicker"
>
  <view class="article-share-picker-sheet" catchtap="noop">
    <view class="article-share-picker-header">
      <view class="article-share-picker-header-copy">
        <text class="article-share-picker-title">选择分享封面</text>
        <text class="article-share-picker-subtitle">点中一张图片后，再点击底部按钮分享小程序卡片</text>
      </view>
      <button class="article-share-picker-close" bindtap="onCloseSharePicker" aria-label="关闭分享封面选择">
        <text class="article-share-picker-close-text">×</text>
      </button>
    </view>

    <scroll-view class="article-share-picker-grid-scroll" scroll-y="{{true}}">
      <view class="article-share-picker-grid">
        <button
          wx:for="{{sharePickerItems}}"
          wx:key="id"
          class="article-share-picker-item {{selectedShareImageKey === item.imageKey ? 'is-selected' : ''}}"
          data-image-url="{{item.imageUrl}}"
          data-image-key="{{item.imageKey}}"
          data-image-index="{{item.imageIndex}}"
          bindtap="onSelectShareImage"
        >
          <image class="article-share-picker-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <view wx:if="{{selectedShareImageKey === item.imageKey}}" class="article-share-picker-selected-badge">已选中</view>
        </button>
      </view>
    </scroll-view>

    <view class="article-share-picker-footer">
      <button
        class="article-share-picker-copy {{selectedShareImage ? 'is-enabled' : 'is-disabled'}}"
        disabled="{{selectedShareImageIndex < 0}}"
        bindtap="onCopyShareLink"
      >复制分享链接</button>
      <button
        class="article-share-picker-confirm {{selectedShareImage ? 'is-enabled' : 'is-disabled'}}"
        disabled="{{selectedShareImageIndex < 0}}"
        open-type="share"
        bindtap="onPrepareShareCard"
      >分享这张卡片</button>
    </view>
  </view>
</view>
